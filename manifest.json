{
   "manifest_version": 3,
   "name": "Image Zoomer",
   "version": "1.2.1",
   "minimum_chrome_version": "88",
   "description": "最简单的图片Hover放大插件，即安即用",
   "author": "merrier1993",
   "icons": {
      "128": "images/icon-128.png"
   },
   "background": {
      "service_worker": "js/background.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "includes/app.js", "includes/sieve_rules.js" ],
      "matches": [ "<all_urls>" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "includes/content.js" ],
      "matches": [ "<all_urls>" ],
      "run_at": "document_end"
   } ],
   "permissions": [ "downloads", "history", "storage" ],
   "host_permissions": [ "*://*/*" ]
}
